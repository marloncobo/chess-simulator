# brazo.rviz — Vista de RViz para mover_xyz.py.
#
# Solo muestra el brazo REAL (simulado) siguiendo /joint_states en tiempo real.
# A propósito NO usa el plugin MotionPlanning de MoveIt, que dibuja la
# trayectoria planificada como un brazo fantasma en bucle y los brazos de
# inicio/destino: aquí solo se ve el movimiento que se ejecuta.
#
# Los ejes en la base indican cómo leer las coordenadas de la GUI:
#   rojo = x (adelante)   verde = y (izquierda)   azul = z (arriba)
Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/MarkerArray
      Name: Tablero y pieza virtual
      Value: true
      Topic:
        Value: /semillero/escena_virtual
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: Brazo
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
      Value: true
    - Class: rviz_default_plugins/Axes
      Name: Ejes de la base (x rojo, y verde, z azul)
      Reference Frame: base_link
      Length: 0.3
      Radius: 0.02
      Value: true
  Global Options:
    Fixed Frame: world
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.0
      Focal Point:
        X: 0.2
        Y: 0.0
        Z: 0.4
      Name: Current View
      Pitch: 0.4
      Target Frame: world
      Yaw: 0.6
Window Geometry:
  Height: 800
  Width: 1100
